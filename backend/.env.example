# --- Database / infra (matches docker-compose.yml) ---
DATABASE_URL="postgresql://rib:rib_password@localhost:5433/reachinbox?schema=public"
REDIS_URL="redis://localhost:6379"
ELASTICSEARCH_NODE="http://localhost:9200"

# --- Server ---
PORT=4000
APP_URL="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"

# --- Queue / rate limiting (CONTEXT section 5) ---
CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Google OAuth (step 8) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Slack OAuth (step 7) ---
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI=""

# --- Seed (step 2): use your real Google email so login "claims" this user later ---
SEED_USER_EMAIL="you@gmail.com"
SEED_SENDER_COUNT=2